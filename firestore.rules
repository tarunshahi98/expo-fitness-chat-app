rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isConversationParticipant(convId, data) {
      return isAuthenticated() && (
        (data != null && 'participants' in data && request.auth.uid in data.participants) ||
        request.auth.uid == convId.split('_')[0] || 
        request.auth.uid == convId.split('_')[1]
      );
    }

    // Admin verification helpers
    function isActiveAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.status == 'Active';
    }

    function getAdminRole() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isActiveAdmin() && getAdminRole() == 'Super Admin';
    }

    function isAdminOrSuperAdmin() {
      return isActiveAdmin() && (getAdminRole() == 'Super Admin' || getAdminRole() == 'Admin');
    }

    // Usernames collection rules (Atomic uniqueness guarantee)
    match /usernames/{username} {
      // Public read allows pre-registration availability check on sign-up screen
      allow read: if true;
      // Creation allowed only if user is authenticated and username format is valid
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z][a-z0-9_]{2,29}$');
      // Usernames cannot be directly transferred between UIDs
      allow update: if false;
      // Allow deletion only by the owner (when changing username or deleting account)
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Users collection rules (Mobile Chat Users)
    match /users/{userId} {
      // Require authentication to read user profiles (prevents unauthenticated scraping)
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);
    }

    // Admin Users & Staff collection rules (Dashboard Staff Isolation & Hierarchical RBAC)
    match /admin_users/{adminId} {
      // An admin can read their own record, or active admins can view staff directory
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isActiveAdmin());
      
      // Super Admins can create any role
      // Bootstrapping: initial Super Admin or user initializing their own root admin record
      // Admins can only create Moderator or Analyst roles
      allow create: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == adminId && request.resource.data.role == 'Super Admin'
      ) || (
        isAdminOrSuperAdmin() && 
        (request.resource.data.role == 'Moderator' || request.resource.data.role == 'Analyst')
      );
      
      // Super Admins have full update/delete rights; active admins can self-update non-sensitive fields
      allow update: if isSuperAdmin() || (
        isActiveAdmin() &&
        request.auth.uid == adminId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
      );
      allow delete: if isSuperAdmin();
    }

    // Conversations & Messages rules
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        (resource != null && 'participants' in resource.data && request.auth.uid in resource.data.participants) ||
        request.auth.uid == conversationId.split('_')[0] ||
        request.auth.uid == conversationId.split('_')[1]
      );
      
      allow create: if isAuthenticated() && (
        ('participants' in request.resource.data && request.auth.uid in request.resource.data.participants) ||
        request.auth.uid == conversationId.split('_')[0] ||
        request.auth.uid == conversationId.split('_')[1]
      );

      allow update: if isConversationParticipant(conversationId, resource.data);
      allow delete: if isConversationParticipant(conversationId, resource.data);
      
      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId, resource.data);
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update: if isAuthenticated()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow delete: if isAuthenticated()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
